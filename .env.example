# ── السيرفر ──
PORT=3001
# مجلد قاعدة البيانات المحلية (ملفات JSON)
DATA_DIR=./server/data

# ── مزود LLM (أي خدمة متوافقة مع OpenAI) ──
# أمثلة لـ BASE_URL:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Groq:      https://api.groq.com/openai/v1
#   OpenRouter:https://openrouter.ai/api/v1
#   Ollama (محلي): http://localhost:11434/v1  (بدون مفتاح — ضع أي نص)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# حد طلبات التحليل/الدقيقة (افتراضي: 240 بدون مفتاح LLM، 60 مع مزود خارجي)
# LLM_RATE_LIMIT=240

# ── التوليد المجدول للإشارات (بديل Scheduled Functions) ──
# عدد الدقائق بين كل توليد تلقائي، 0 = معطل
AI_CRON_MINUTES=0
# مدة صلاحية الإشارة قبل انتهائها تلقائياً (دقائق)
SIGNAL_TTL_MINUTES=60

# ── عامل السيرفر (يعمل بلا متصفح: مراقب إغلاق + مولد + متعلم) ──
# إيقاف العامل كاملاً (عندها تعود محركات المتصفح للعمل)
WORKER_ENABLED=true
# دورة مراقب الصفقات بالثواني (10..600) — يغلق SL/TP ويحدّث PnL
WORKER_MONITOR_SECONDS=30
# دورة تسجيل الدروس بالثواني (60..3600)
WORKER_LEARN_SECONDS=300
# إغلاق صفقات live الحقيقية بأوامر سوق (خطير — افتراضياً معطّل)
WORKER_LIVE_CLOSE=false
# إغلاق الصفقة بعد N ساعة مهما كان وضعها (0 = معطّل)
WORKER_MAX_HOLD_HOURS=0
# دورة مرسل Telegram بالثواني (يعمل فقط إن أدخلت التوكن من الإعدادات)
WORKER_NOTIFY_SECONDS=60

# ── Binance (اختياري — تُدخل من صفحة الإعدادات داخل التطبيق أيضاً) ──
BINANCE_BASE_URL=https://api.binance.com
# نطاق بديل لبيانات السوق العامة (يُستخدم تلقائياً عند حجب/تعطل النطاق الأساسي)
BINANCE_PUBLIC_BASE_URL=https://data-api.binance.vision
# شبكة الاختبار (فقط عند اختيار testnet في الإعدادات + مفاتيح testnet)
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
# سقف القيمة الاسمية للأمر الحي الواحد بالدولار (0 = تعطيل الأوامر الحية نهائياً)
MAX_LIVE_NOTIONAL_USD=1000

# ── الحماية ──
# CORS origins المسموحة (مفصولة بفواصل)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# ضع توكن هنا ليتطلب كل /api/* ترويسة x-api-token (واتركه فارغاً للتشغيل المحلي فقط)
LOCAL_API_TOKEN=
# للواجهة: VITE_API_TOKEN يجب أن يطابق LOCAL_API_TOKEN عند تفعيله
# VITE_API_TOKEN=
# تقييد موديلات LLM المسموحة (اختياري، مفصول بفواصل). اتركه فارغاً لقبول أي اسم سليم.
LLM_ALLOWED_MODELS=
# السماح للعميل بتجاوز system prompt (غير موصى به — اتركه false)
ALLOW_CUSTOM_SYSTEM=false
